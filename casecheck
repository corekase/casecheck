#!/usr/bin/env python3
r"""
casecheck.py - find names that will cause trouble when a tree moves to Windows.

Problems are reported with one of these tags:

  CASE    entries in the same directory whose names differ only by case, e.g.
          "Readme.txt" and "README.TXT" (Windows is case-insensitive).
  MERGE   same-named entries inside directories that case-collide: if "Foo/"
          and "foo/" both exist, Windows merges them, so Foo/a.txt and
          foo/a.txt collide too.
  NAME    names Windows cannot store: reserved device names (CON, PRN, AUX,
          NUL, CONIN$, CONOUT$, COM1-COM9, LPT1-LPT9 and the superscript-digit
          variants, in any case and with any extension, so "aux.c" counts),
          illegal characters (< > : " \ | ? * and control characters 0-31),
          trailing dots or spaces (Windows strips them), and names longer than
          255 characters.
  LENGTH  the full Windows path reaches MAX_PATH (260 characters including the
          terminating NUL), or for folders MAX_PATH - 12 (so an 8.3 filename
          can still be appended). Paths are measured as if the scanned
          directory lived at --dest (default: C:\<name of the scanned
          directory>), counting UTF-16 code units the way Windows does.
  ERROR   something went wrong while scanning: an unreadable directory, a
          scan target that isn't a directory, or a crash.

Output: one record per line, four TAB-separated fields:

    TAG <TAB> TYPE <TAB> PATH <TAB> DETAIL

  TYPE    dir, file, or link (a symlink); "-" when it doesn't apply.
  PATH    relative to the scanned directory. Control characters, including
          tab and newline, appear as \xNN so a record is always one line.
  DETAIL  CASE, MERGE: group=N. Entries with the same N collide with each other.
          NAME:        comma-separated reasons: reserved=NUL, illegal=<chars>,
                       trailing-dot, trailing-space, name-length=N
          LENGTH:      len=N,limit=N   (limit = longest allowed path)
          ERROR:       the error message

Lines starting with "#" are comments for people; parsers can skip them. The
last line is "# summary ..." with a count per tag (CASE and MERGE count
groups) and the assumptions used for path lengths.

Logging is off by default. With --log, every line printed to the console is
also appended, unchanged, to the file given by --error-log (default:
casecheck-errors.log in the current directory), so the two always match. The
file is only created if there is at least one problem or error; a clean run
with --log creates no file.

Exit status: 0 = no problems, 1 = problems found, 2 = error / incomplete scan.

Symlinks are never followed; they are treated as ordinary entries.
"""

import argparse
import logging
import os
import sys
import traceback
from collections import defaultdict

_DEVICE_NUMBERS = "123456789\u00b9\u00b2\u00b3"  # 1-9 plus superscript 1, 2, 3
RESERVED_NAMES = {"CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$"}
RESERVED_NAMES |= {f"{dev}{n}" for dev in ("COM", "LPT") for n in _DEVICE_NUMBERS}

ILLEGAL_CHARS = set('<>:"\\|?*') | {chr(c) for c in range(32)}

MAX_COMPONENT = 255  # longest single file/folder name on NTFS
DEFAULT_MAX_PATH = 260  # Windows MAX_PATH, counting the terminating NUL
DIR_PATH_MARGIN = 12  # folders must leave room for an 8.3 filename

DEFAULT_ERROR_LOG = "casecheck-errors.log"

# Logging is off until --log is given: the level is above anything we emit,
# and with only a NullHandler attached nothing reaches the root logger.
log = logging.getLogger("casecheck")
log.addHandler(logging.NullHandler())
log.propagate = False
log.setLevel(logging.CRITICAL + 1)


class SafeFormatter(logging.Formatter):
    """Keep log lines valid UTF-8 even if a filename has undecodable bytes."""

    def format(self, record):
        text = super().format(record)
        return text.encode("utf-8", "backslashreplace").decode("utf-8")


def check_error_log_path(path):
    """Return a message if `path` can't be appended to, otherwise None."""
    if os.path.isdir(path):
        return f"error log is a directory: {path}"
    if os.path.exists(path):
        writable = os.access(path, os.W_OK)
    else:
        parent = os.path.dirname(os.path.abspath(path))
        writable = os.path.isdir(parent) and os.access(parent, os.W_OK | os.X_OK)
    return None if writable else f"cannot write to error log: {path}"


def setup_logging(error_log):
    """Turn logging on: lines passed to emit() are also appended to `error_log`."""
    log.setLevel(logging.ERROR)
    # delay=True: the file is only created when the first line is written, so a
    # run with nothing to report leaves no file behind.
    to_file = logging.FileHandler(error_log, mode="a", encoding="utf-8", delay=True)
    to_file.setFormatter(SafeFormatter("%(message)s"))  # the line, nothing added
    log.addHandler(to_file)


def emit(lines, stream=None):
    """
    Print lines to the console and, when --log is on, append the very same
    lines to the error log. Everything the script reports goes through here,
    which is what keeps the console and the log file identical.
    """
    stream = stream or sys.stdout
    for line in lines:
        print(line, file=stream)
        log.error("%s", line)


def fold(name):
    """
    Approximate how Windows (NTFS) compares names: a per-character, simple
    uppercase mapping. Unlike str.casefold(), this does not treat e.g.
    'ß' and 'ss' as equal, because Windows doesn't either.
    """
    out = []
    for ch in name:
        up = ch.upper()
        out.append(up if len(up) == 1 else ch)
    return "".join(out)


def wlen(text):
    """Length in UTF-16 code units, which is how Windows counts characters."""
    return len(text.encode("utf-16-le", "surrogatepass")) // 2


def printable(text):
    """Escape control characters so odd filenames can't break a record."""
    return "".join(
        f"\\x{ord(c):02x}" if ord(c) < 32 or ord(c) == 127 else c for c in text
    )


def reserved_name(name):
    """
    Return the Windows device name that `name` maps to, or None.

    Only the part before the first '.' counts (so "NUL.tar.gz" is reserved),
    and trailing spaces before the extension are ignored ("NUL .txt").
    """
    stem = name.split(".", 1)[0].split(":", 1)[0].rstrip(" ")
    key = fold(stem)
    return key if key in RESERVED_NAMES else None


def invalid_codes(name):
    """Return short codes for each reason Windows can't use `name`."""
    codes = []

    device = reserved_name(name)
    if device:
        codes.append(f"reserved={device}")

    bad = sorted({c for c in name if c in ILLEGAL_CHARS})
    if bad:
        codes.append("illegal=" + "".join(printable(c) for c in bad))

    if name.endswith("."):
        codes.append("trailing-dot")
    if name.endswith(" "):
        codes.append("trailing-space")

    length = wlen(name)
    if length > MAX_COMPONENT:
        codes.append(f"name-length={length}")

    return codes


def kind(path):
    """'link', 'dir' or 'file' for the entry at `path`."""
    if os.path.islink(path):
        return "link"
    if os.path.isdir(path):
        return "dir"
    return "file"


def scan(root, errors, dest, max_path):
    """
    Walk `root` and return (groups, invalid, too_long).

    groups:   {case-folded relative path (tuple): [real relative paths]}
    invalid:  [(relative path, [codes])] for names Windows can't use
    too_long: [(relative path, windows length, limit)] for paths over the limit

    Directories that can't be read are appended to `errors`.
    `dest` is the Windows path (backslash separated, no trailing separator)
    where the scanned directory is assumed to end up.
    """
    groups = defaultdict(list)
    invalid = []
    too_long = []

    # Longest path, in characters, that fits once the terminating NUL is counted.
    file_limit = max_path - 1
    dir_limit = max_path - DIR_PATH_MARGIN - 1

    for dirpath, dirnames, filenames in os.walk(root, onerror=errors.append):
        rel = os.path.relpath(dirpath, root)
        parts = [] if rel == "." else rel.split(os.sep)
        parent_key = tuple(fold(p) for p in parts)
        # Length of this directory's full Windows path.
        dir_len = wlen(dest) + sum(1 + wlen(p) for p in parts)

        for names, is_dir in ((dirnames, True), (filenames, False)):
            for name in names:
                rel_path = os.path.join(*parts, name)
                groups[parent_key + (fold(name),)].append(rel_path)

                codes = invalid_codes(name)
                if codes:
                    invalid.append((rel_path, codes))

                full_len = dir_len + 1 + wlen(name)
                limit = dir_limit if is_dir else file_limit
                if full_len > limit:
                    too_long.append((rel_path, full_len, limit))

    return groups, invalid, too_long


def record(tag, entry_type, path, detail):
    """One output line: TAG, TYPE, PATH and DETAIL separated by tabs."""
    return "\t".join((tag, entry_type, printable(path), printable(detail)))


def error_path(err, root):
    """Path of a directory that couldn't be read, relative to the scanned root."""
    name = str(err.filename)
    try:
        return os.path.relpath(name, root)
    except ValueError:
        return name


def build_records(root, same_dir, merged, invalid, too_long, errors):
    """Turn the scan results into output lines, grouped by tag."""
    lines = []

    group = 0
    for tag, conflicts in (("CASE", same_dir), ("MERGE", merged)):
        for paths in conflicts:
            group += 1
            for p in paths:
                lines.append(record(tag, kind(os.path.join(root, p)), p, f"group={group}"))

    for path, codes in sorted(invalid):
        lines.append(record("NAME", kind(os.path.join(root, path)), path, ",".join(codes)))

    for path, length, limit in sorted(too_long, key=lambda i: (i[2] - i[1], i[0])):
        lines.append(
            record("LENGTH", kind(os.path.join(root, path)), path, f"len={length},limit={limit}")
        )

    for err in errors:
        lines.append(record("ERROR", "dir", error_path(err, root), err.strerror or "read error"))

    return lines


def main():
    parser = argparse.ArgumentParser(
        description="Recursively find names that would be a problem on Windows: "
        "files/folders differing only by case, reserved names, illegal "
        "characters, trailing dots or spaces, and paths that are too long. "
        "Output is one tab-separated record per line: TAG, TYPE, PATH, DETAIL."
    )
    parser.add_argument("directory", help="directory to scan")
    parser.add_argument(
        "--siblings-only",
        action="store_true",
        help="for case conflicts, only report entries in the same directory "
        "(skip conflicts that arise from merging case-colliding directories)",
    )
    parser.add_argument(
        "--dest",
        metavar="WINPATH",
        help="Windows path where the scanned directory will end up, used to "
        "measure path lengths, e.g. 'C:\\Users\\me\\projects\\mydir'. "
        "Default: C:\\<name of the scanned directory>",
    )
    parser.add_argument(
        "--max-path",
        type=int,
        default=DEFAULT_MAX_PATH,
        metavar="N",
        help="Windows MAX_PATH to check against, counting the terminating NUL "
        f"(default {DEFAULT_MAX_PATH}). Folders are held to N - {DIR_PATH_MARGIN}. "
        "Raise it if long-path support is enabled on the target machine.",
    )
    parser.add_argument(
        "--log",
        action="store_true",
        help="enable logging (default: off). Everything printed to the console "
        "is also appended, unchanged, to the --error-log file.",
    )
    parser.add_argument(
        "--error-log",
        metavar="FILE",
        help="text file used by --log (default: "
        f"{DEFAULT_ERROR_LOG} in the current directory). It is only created if "
        "there is at least one problem or error.",
    )
    args = parser.parse_args()

    if args.max_path <= DIR_PATH_MARGIN + 1:
        parser.error(f"--max-path must be greater than {DIR_PATH_MARGIN + 1}")
    if args.error_log is not None and not args.log:
        parser.error("--error-log requires --log")

    # Don't crash on undecodable filenames when printing.
    try:
        sys.stdout.reconfigure(errors="backslashreplace")
        sys.stderr.reconfigure(errors="backslashreplace")
    except AttributeError:
        pass

    if args.log:
        error_log = args.error_log or DEFAULT_ERROR_LOG
        problem = check_error_log_path(error_log)
        if problem:
            parser.error(problem)
        setup_logging(error_log)

    root = args.directory
    if not os.path.isdir(root):
        emit([record("ERROR", "-", root, "not a directory")], sys.stderr)
        return 2

    if args.dest is not None:
        dest = args.dest.rstrip("\\/")
    else:
        dest = ("C:\\" + os.path.basename(os.path.abspath(root))).rstrip("\\/")

    errors = []
    groups, invalid, too_long = scan(root, errors, dest, args.max_path)

    same_dir, merged = [], []
    for paths in groups.values():
        if len(paths) < 2:
            continue
        parents = {os.path.dirname(p) for p in paths}
        (same_dir if len(parents) == 1 else merged).append(sorted(paths))
    same_dir.sort()
    merged.sort()
    if args.siblings_only:
        merged = []

    lines = build_records(root, same_dir, merged, invalid, too_long, errors)
    summary = (
        f"# summary case={len(same_dir)} merge={len(merged)} name={len(invalid)} "
        f"length={len(too_long)} error={len(errors)} "
        f"dest={printable(dest)} max_path={args.max_path}"
    )
    if lines:
        emit(lines + [summary])
    else:
        print(summary)  # a clean run: nothing to log, so no log file

    if same_dir or merged or invalid or too_long:
        return 1
    return 2 if errors else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # Output was piped to something like `head` that closed early.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
    except Exception as exc:
        crash = [record("ERROR", "-", "-", f"{type(exc).__name__}: {exc}")]
        crash += ["# " + printable(l) for l in traceback.format_exc().rstrip().splitlines()]
        emit(crash, sys.stderr)
        sys.exit(2)
